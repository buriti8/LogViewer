{
    "name":        "buriti8/log-viewer",
    "description": "Log Viewer for Laravel with compiled assets included. Fork of arcanedev/log-viewer",
    "keywords":    ["buriti8", "arcanedev", "arcanesoft", "laravel", "log", "log viewer", "log-viewer", "logviewer"],
    "homepage":    "https://github.com/buriti8/LogViewer",
    "authors": [
        {
            "name":     "buriti8",
            "homepage": "https://github.com/buriti8",
            "role":     "Maintainer"
        },
        {
            "name":     "ARCANEDEV",
            "email":    "arcanedev.maroc@gmail.com",
            "homepage": "https://github.com/arcanedev-maroc",
            "role":     "Original author"
        }
    ],
    "support": {
        "issues": "https://github.com/buriti8/LogViewer/issues",
        "source": "https://github.com/buriti8/LogViewer"
    },
    "type":    "library",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "ext-json": "*",
        "buriti8/support": "^12.0",
        "psr/log": "^1.0|^2.0|^3.0"
    },
    "require-dev": {
        "laravel/framework": "^12.0",
        "mockery/mockery": "^1.6",
        "orchestra/testbench-core": "^10.0",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Arcanedev\\LogViewer\\": "src/"
        },
        "files": ["helpers.php"]
    },
    "autoload-dev": {
        "psr-4": {
            "Arcanedev\\LogViewer\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit --colors=always",
        "test:dox": "phpunit --testdox --colors=always",
        "test:cov": "phpunit --coverage-html build/coverage"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Arcanedev\\LogViewer\\LogViewerServiceProvider",
                "Arcanedev\\LogViewer\\Providers\\DeferredServicesProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
